      <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0" spacing="15.0" BorderPane.alignment="CENTER">
         <children>
            <Button fx:id="qcmbutton" mnemonicParsing="false" onAction="#launchQCM" text="QCM" />
            <Button fx:id="pollButton" mnemonicParsing="false" onAction="#launchPoll" text="Poll" />
            <Button fx:id="freeButton" mnemonicParsing="false" onAction="#launchFree" text="free" />
         </children>
      </HBox>
   </center>
</BorderPane>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="be.helha.clapetteChaussette.client.view.editor.McqEditorFX">
   <top>
      <HBox prefHeight="100.0" prefWidth="200.0" BorderPane.alignment="CENTER">
         <children>
            <AnchorPane prefHeight="200.0" prefWidth="200.0" HBox.hgrow="ALWAYS">
               <children>
                  <TextField fx:id="questionTitle" alignment="TOP_CENTER" layoutX="157.0" layoutY="61.0" prefWidth="300.0" promptText="Please enter your question" />
                  <Label layoutX="228.0" layoutY="15.0" text="New MCQ">
                     <font>
                        <Font size="24.0" />
                     </font>
                  </Label>
               </children>
            </AnchorPane>
         </children>
      </HBox>
   </top>
   <bottom>
      <HBox alignment="CENTER_LEFT" prefHeight="100.0" prefWidth="200.0" BorderPane.alignment="CENTER">
         <children>
            <AnchorPane prefHeight="200.0" prefWidth="200.0" HBox.hgrow="ALWAYS">
               <children>
                  <Button fx:id="addAnswerBTN" layoutX="42.0" layoutY="38.0" mnemonicParsing="false" onAction="#addNewAnswer" text="+" />
                  <Button fx:id="saveQuestionBTN" alignment="CENTER_RIGHT" layoutX="481.0" layoutY="38.0" mnemonicParsing="false" onAction="#createQuestion" text="Save" />
               </children>
            </AnchorPane>
         </children>
      </HBox>
   </bottom>
   <center>
      <ScrollPane fitToWidth="true" hbarPolicy="NEVER" prefHeight="200.0" prefWidth="200.0" BorderPane.alignment="CENTER">
         <content>
            <VBox fx:id="answersContainer" prefHeight="200.0" prefWidth="100.0" />
         </content>
      </ScrollPane>
   </center>
</BorderPane>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="be.helha.clapetteChaussette.view.editor.OpenEditorFX">
    <top>
        <VBox alignment="CENTER" spacing="10.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="10.0" top="10.0" />
            </padding>
            <children>
                <Label text="New Open Question">
                    <font>
                        <Font name="System Bold" size="20.0" />
                    </font>
                </Label>
                <TextField fx:id="questionTitle" maxWidth="450.0" promptText="Write your question here..." />
                <CheckBox fx:id="pointsCheckBox" mnemonicParsing="false" text="This question is worth points" />
            </children>
        </VBox>
    </top>
    <center>
        <VBox spacing="5.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets left="20.0" right="20.0" />
            </padding>
            <children>
                <Label text="Accepted answers :" />
                <ScrollPane fitToWidth="true" prefHeight="200.0">
                    <content>
                        <VBox fx:id="answersContainer" spacing="5.0" />
                    </content>
                </ScrollPane>
                <Button fx:id="addAnswerBTN" onAction="#addNewAnswer" text="+ Add variant" />
            </children>
        </VBox>
    </center>
    <bottom>
        <HBox alignment="CENTER_RIGHT" prefHeight="60.0" spacing="20.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets right="20.0" />
            </padding>
            <children>
                <Button onAction="#saveQuestion" style="-fx-background-color: #2ecc71;" text="Save" textFill="WHITE" />
            </children>
        </HBox>
    </bottom>
</BorderPane>
<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="20.0" prefHeight="300.0" prefWidth="400.0" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="be.helha.clapetteChaussette.client.view.LoginViewFX">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>
        <Label text="Connexion Enseignant" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
        <TextField fx:id="nameField" promptText="Nom d'utilisateur" maxWidth="250"/>
        <PasswordField fx:id="passwordField" promptText="Mot de passe" maxWidth="250"/>
        <HBox alignment="CENTER" spacing="10">
            <Button text="Se connecter" onAction="#handleLogin" styleClass="card-blue"/>
            <Button text="S'inscrire" onAction="#handleRegister" styleClass="card-green"/>
        </HBox>
    </children>
</VBox>
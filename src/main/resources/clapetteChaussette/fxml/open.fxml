<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" prefHeight="400.0" prefWidth="600.0" spacing="20.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="be.helha.clapetteChaussette.view.OpenQuestionFX">
    <children>
        <Label prefHeight="68.0" prefWidth="212.0" text="Questionnaire libre">
            <font>
                <Font size="23.0" />
            </font>
        </Label>
        <Label fx:id="questionFree" text="Chargement..." />
        <TextArea fx:id="textArea" maxWidth="400.0" prefHeight="71.0" prefWidth="492.0" promptText="entrer votre reponse" scrollLeft="1.0">
            <font>
                <Font name="Agency FB" size="24.0" />
            </font>
        </TextArea>
        <AnchorPane prefHeight="153.0" prefWidth="600.0">
            <children>
                <Button fx:id="envoyerBtn" alignment="CENTER" contentDisplay="CENTER" layoutX="191.0" layoutY="31.0" mnemonicParsing="false" onAction="#handleSendAction" prefHeight="46.0" prefWidth="173.0" text="Envoyer" textAlignment="JUSTIFY" />
            </children>
        </AnchorPane>
    </children>
</VBox>
